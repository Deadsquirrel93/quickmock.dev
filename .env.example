# Mock API — environment variables.
# Copy to .env and fill in real values. Never commit .env.

# Where the Go server listens.
QUICKMOCK_ADDR=:8080

# Public base URL — used to render copy-paste mock URLs in the UI.
QUICKMOCK_BASE_URL=http://localhost:8080

# ---- PostgreSQL ----
# When running on the host directly:
#   QUICKMOCK_PG_DSN=postgres://quickmock:quickmock@127.0.0.1:5432/quickmock?sslmode=disable
# When running via docker compose, leave this empty — compose injects a DSN
# that points to the postgres service. Just set POSTGRES_PASSWORD below.
QUICKMOCK_PG_DSN=postgres://quickmock:quickmock@127.0.0.1:5432/quickmock?sslmode=disable

# Used only by docker compose to provision the postgres container.
# Generate with: openssl rand -hex 32
# Do NOT use `openssl rand -base64` — `/` and `+` break the pgx DSN URL parser.
POSTGRES_PASSWORD=change_me_use_openssl_rand_hex_32

# ---- Redis ----
QUICKMOCK_REDIS_ADDR=127.0.0.1:6379

# ---- Rate limiting ----
# How many mock hits one IP can make per window.
QUICKMOCK_RATE_IP=5000
# Window length (Go duration: "8h", "30m", "1h").
QUICKMOCK_RATE_WINDOW=8h

# Maximum number of active mocks one IP can own at once.
QUICKMOCK_MAX_MOCKS=50

# ---- Mock content ----
# Maximum response body size, bytes. 512 KB by default.
QUICKMOCK_MAX_BODY=524288

# Default TTL for newly created mocks (Go duration string).
QUICKMOCK_DEFAULT_TTL=168h

# Maximum ttl_seconds a mock can request or extend to, from its creation
# date (Go duration string).
QUICKMOCK_MAX_TTL=720h

# ---- Localization ----
QUICKMOCK_DEFAULT_LANG=en

# ---- Request inspector (SSE) ----
# Caps for concurrent Server-Sent Events connections (the live inspector).
QUICKMOCK_SSE_MAX_CONNS=500
QUICKMOCK_SSE_MAX_PER_IP=4

# ---- Anti-spam ----
# Content filter for mock create/update. Unset = built-in default patterns.
# Point at a file (one RE2 regex per line, # comments) to replace them,
# or set to "off" to disable.
#QUICKMOCK_SPAM_PATTERNS_FILE=/etc/quickmock/spam-patterns.txt
# Comma-separated IPs / CIDR blocks that skip the filter (false-positive escape hatch).
#QUICKMOCK_SPAM_ALLOW_IPS=203.0.113.9,10.0.0.0/8
